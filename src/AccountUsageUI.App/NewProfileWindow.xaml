<Window x:Class="AccountUsageUI.App.NewProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccountUsageUI.App"
        Title="새 프로필 등록"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontPrimary}"
        Closing="OnWindowClosing">

    <Border Background="{StaticResource BrushAppBg}"
            BorderBrush="{StaticResource BrushLinePrimary}"
            BorderThickness="{StaticResource BorderStrokePrimary}"
            CornerRadius="{StaticResource RadiusPanel}"
            Margin="10">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" local:TitleBarDragBehavior.EnableWindowDrag="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Antigravity 프로필 등록"
                               FontFamily="{StaticResource FontHeading}"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="프로필 이름을 입력한 뒤, 현재 로그인된 계정을 즉시 캡처하거나 새 계정으로 로그인하세요."
                               Margin="0,3,0,0"
                               FontSize="12.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        VerticalAlignment="Top"
                        Click="OnCancelClicked"
                        ToolTip="닫기">
                    <Path Data="{StaticResource IconClose}"
                          Stroke="{StaticResource BrushLinePrimary}"
                          StrokeThickness="2.2"
                          Width="12"
                          Height="12"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- 2. Profile Name Input Card -->
            <Border Grid.Row="1"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushLinePrimary}"
                    BorderThickness="{StaticResource BorderStrokePrimary}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="18,16"
                    Margin="0,16,0,14">
                <StackPanel>
                    <TextBlock Text="프로필 이름"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBox x:Name="ProfileNameTextBox"
                             Style="{StaticResource IvoryTextBoxStyle}"
                             Margin="0,8,0,0"
                             MaxLength="64"
                             KeyDown="OnProfileNameKeyDown" />
                    <TextBlock Text="예: 개인 Pro 계정, 업무용 Ultra, 서브 계정"
                               Margin="2,6,0,0"
                               FontSize="12"
                               FontWeight="Normal"
                               Foreground="{StaticResource BrushTextMuted}" />
                </StackPanel>
            </Border>

            <!-- 3. Registration Mode Card -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushLinePrimary}"
                    BorderThickness="{StaticResource BorderStrokePrimary}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="18,16"
                    Margin="0,0,0,14">
                <StackPanel>
                    <!-- Mode A: Instant Capture (Visible before new-login session starts) -->
                    <StackPanel x:Name="InitialSelectionPanel">
                        <TextBlock Text="등록 방식 선택"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}" />

                        <Button x:Name="CaptureCurrentButton"
                                Style="{StaticResource PrimaryKeycapButtonStyle}"
                                HorizontalContentAlignment="Left"
                                Padding="16,12"
                                Margin="0,10,0,10"
                                Click="OnCaptureCurrentClicked">
                            <StackPanel>
                                <TextBlock Text="현재 로그인된 Antigravity 계정 바로 등록 (권장)"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="실행 중인 Antigravity를 종료하지 않고 지금 로그인된 계정을 즉시 프로필로 저장합니다."
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="StartNewLoginButton"
                                Style="{StaticResource SecondaryKeycapButtonStyle}"
                                HorizontalContentAlignment="Left"
                                Padding="16,12"
                                Click="OnStartNewLoginClicked">
                            <StackPanel>
                                <TextBlock Text="다른 계정으로 새로 로그인하여 등록"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="현재 인증 세션을 안전하게 백업한 뒤 Antigravity를 재실행하여 새 Google 계정으로 로그인합니다."
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Mode B: Waiting for New Login Completion -->
                    <StackPanel x:Name="AwaitingLoginPanel" Visibility="Collapsed">
                        <Border Background="{StaticResource BrushSurfaceWarn}"
                                BorderBrush="{StaticResource BrushLinePrimary}"
                                BorderThickness="2"
                                CornerRadius="14"
                                Padding="14,12"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Antigravity에서 새 계정 로그인을 완료해 주세요"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock Text="실행된 Antigravity 창에서 Google 로그인을 마친 뒤 아래 '로그인 완료 및 프로필 저장' 버튼을 눌러 주세요."
                                           Margin="0,4,0,0"
                                           FontSize="12.5"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource BrushTextSecondary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="CompleteNewLoginButton"
                                Content="로그인 완료 및 프로필 저장"
                                Style="{StaticResource PrimaryKeycapButtonStyle}"
                                Padding="16,11"
                                Click="OnCompleteNewLoginClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. Status Banner & Cancel Button -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           Margin="2,0,12,0"
                           FontSize="12.5"
                           FontWeight="Normal"
                           Foreground="{StaticResource BrushTextSecondary}"
                           TextWrapping="Wrap" />

                <Button x:Name="CancelButton"
                        Grid.Column="1"
                        Content="취소"
                        Style="{StaticResource SecondaryKeycapButtonStyle}"
                        MinWidth="88"
                        Click="OnCancelClicked" />
            </Grid>
        </Grid>
    </Border>
</Window>
