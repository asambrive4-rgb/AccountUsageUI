<Window x:Class="AccountUsageUI.App.DeleteProfileConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccountUsageUI.App"
        Title="프로필 삭제 확인"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontPrimary}">

    <Border Background="{StaticResource BrushAppBg}"
            BorderBrush="{StaticResource BrushLinePrimary}"
            BorderThickness="{StaticResource BorderStrokePrimary}"
            CornerRadius="{StaticResource RadiusPanel}"
            Margin="10">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" local:TitleBarDragBehavior.EnableWindowDrag="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="프로필 삭제"
                           FontFamily="{StaticResource FontHeading}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        Click="OnCancelClicked"
                        ToolTip="닫기">
                    <Path Data="{StaticResource IconClose}"
                          Stroke="{StaticResource BrushLinePrimary}"
                          StrokeThickness="2.2"
                          Width="12"
                          Height="12"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- Content Card -->
            <Border Grid.Row="1"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushLinePrimary}"
                    BorderThickness="{StaticResource BorderStrokePrimary}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="18,16"
                    Margin="0,16,0,18">
                <StackPanel>
                    <TextBlock x:Name="ConfirmationText"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="저장된 프로필 인증 스냅샷과 사용량 캐시가 삭제됩니다. Antigravity의 대화 내역이나 워크스페이스 파일은 삭제되지 않습니다."
                               Margin="0,8,0,0"
                               FontSize="12.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource BrushTextSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="취소"
                        Style="{StaticResource SecondaryKeycapButtonStyle}"
                        MinWidth="88"
                        Margin="0,0,10,0"
                        Click="OnCancelClicked" />
                <Button Content="삭제"
                        Style="{StaticResource DangerKeycapButtonStyle}"
                        MinWidth="96"
                        Click="OnDeleteClicked" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
