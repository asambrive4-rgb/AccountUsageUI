<Window x:Class="AccountUsageUI.App.ProfilePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccountUsageUI.App"
        Title="Antigravity Mini Popup"
        Width="284"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        FontFamily="{StaticResource FontPrimary}">

    <Border Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushLinePrimary}"
            BorderThickness="{StaticResource BorderStrokePrimary}"
            CornerRadius="{StaticResource RadiusCard}"
            Margin="6"
            Padding="14,12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Row: Active Profile Name & Mini Controls -->
            <Grid Grid.Row="0" local:TitleBarDragBehavior.EnableWindowDrag="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8"
                                Height="8"
                                CornerRadius="4"
                                Background="{StaticResource BrushLinePrimary}"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0" />
                        <TextBlock Text="{Binding DefaultPopupProfile.Name, FallbackValue='활성 프로필 없음'}"
                                   FontFamily="{StaticResource FontHeading}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding DefaultPopupProfile.Status, FallbackValue='대기 중'}"
                               FontSize="11.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="14,1,0,0" />
                </StackPanel>

                <!-- Mini Keycap Buttons: Return to Main, Quick Switch, Minimize -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource WindowControlButtonStyle}"
                            Width="30"
                            Height="30"
                            MinHeight="30"
                            Margin="0,0,5,0"
                            Click="OnReturnToMainClicked"
                            ToolTip="기본 창으로 복귀">
                        <Path Data="{StaticResource IconReturn}"
                              Fill="{StaticResource BrushLinePrimary}"
                              Width="13"
                              Height="13"
                              Stretch="Uniform" />
                    </Button>

                    <Button x:Name="QuickSwitchButton"
                            Style="{StaticResource PrimaryKeycapButtonStyle}"
                            Width="30"
                            Height="30"
                            MinHeight="30"
                            Padding="0"
                            Margin="0,0,5,0"
                            Click="OnQuickSwitchClicked"
                            ToolTip="다른 프로필로 전환">
                        <Path Data="{StaticResource IconSwitch}"
                              Fill="{StaticResource BrushLinePrimary}"
                              Width="14"
                              Height="14"
                              Stretch="Uniform" />
                    </Button>

                    <Button Style="{StaticResource WindowControlButtonStyle}"
                            Width="30"
                            Height="30"
                            MinHeight="30"
                            Click="OnMinimizeClicked"
                            ToolTip="최소화">
                        <Path Data="{StaticResource IconMinimize}"
                              Stroke="{StaticResource BrushLinePrimary}"
                              StrokeThickness="2.2"
                              Width="11"
                              Height="11"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Bottom Row: Recently Used Model Quota Card (Antigravity Spc Style) -->
            <Border Grid.Row="1"
                    Background="{StaticResource BrushAppBg}"
                    BorderBrush="{StaticResource BrushLinePrimary}"
                    BorderThickness="2"
                    CornerRadius="13"
                    Padding="12,10"
                    Margin="0,10,0,0"
                    local:TitleBarDragBehavior.EnableWindowDrag="True">
                <StackPanel DataContext="{Binding DefaultPopupProfile.RecentModelUsage}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ShortName, FallbackValue='Usage'}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding PercentLeftText, FallbackValue='--'}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{Binding PercentForeground}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Path Data="{Binding RingTrackGeometry}"
                                      Stroke="{StaticResource BrushSurfaceMuted}"
                                      StrokeThickness="2"
                                      Width="16"
                                      Height="16" />
                                <Path Data="{Binding RingArcGeometry}"
                                      Stroke="{Binding ProgressBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="16"
                                      Height="16" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding HasSecondRow, Converter={StaticResource BoolToVis}}"
                          Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DetailLabel}"
                                   FontSize="11.5"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ResetTimeText}"
                                   HorizontalAlignment="Right"
                                   FontSize="11.5"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
