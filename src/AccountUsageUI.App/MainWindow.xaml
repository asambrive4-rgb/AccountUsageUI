<Window x:Class="AccountUsageUI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccountUsageUI.App"
        xmlns:presentation="clr-namespace:AccountUsageUI.App.Presentation"
        Title="Antigravity Account Switcher"
        Width="860"
        Height="740"
        MinWidth="680"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="{StaticResource FontPrimary}"
        Closing="OnWindowClosing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="7"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Bucket Row DataTemplate (Matches Antigravity Spc Component) -->
        <DataTemplate x:Key="QuotaBucketRowTemplate" DataType="{x:Type presentation:ModelQuotaItemViewModel}">
            <Grid Margin="0,3,0,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Line 1: Title (left) & "XX% left" + Circular Ring Gauge (right) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{Binding TitleForeground}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                        <TextBlock Text="{Binding PercentLeftText}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{Binding PercentForeground}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0" />

                        <!-- 16x16 Circular Ring Gauge -->
                        <Grid Width="16" Height="16" VerticalAlignment="Center">
                            <Path Data="{Binding RingTrackGeometry}"
                                  Stroke="{StaticResource BrushSurfaceMuted}"
                                  StrokeThickness="2"
                                  Width="16"
                                  Height="16" />
                            <Path Data="{Binding RingArcGeometry}"
                                  Stroke="{Binding ProgressBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="16"
                                  Height="16" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Line 2 (Conditional): Detail label (e.g. "Weekly limit") & Reset subtext (e.g. "Resets in 6d 23h") -->
                <Grid Grid.Row="1"
                      Visibility="{Binding HasSecondRow, Converter={StaticResource BoolToVis}}"
                      Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding DetailLabel}"
                               FontSize="11.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ResetTimeText}"
                               FontSize="11.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="10,0,0,0" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Group Section DataTemplate (Matches Antigravity Tpc Component) -->
        <DataTemplate x:Key="QuotaGroupTemplate" DataType="{x:Type presentation:QuotaGroupViewModel}">
            <StackPanel Margin="0,3,0,5">
                <!-- Group Header (Shown when group has multiple buckets: e.g. "Gemini Models", "Claude and GPT models") -->
                <TextBlock Text="{Binding GroupTitle}"
                           Visibility="{Binding HasGroupHeader, Converter={StaticResource BoolToVis}}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           Margin="0,2,0,2" />

                <!-- Buckets inside the group -->
                <ItemsControl ItemsSource="{Binding Buckets}"
                              ItemTemplate="{StaticResource QuotaBucketRowTemplate}" />
            </StackPanel>
        </DataTemplate>

        <!-- Reusable Profile Card DataTemplate -->
        <DataTemplate x:Key="ProfileCardTemplate" DataType="{x:Type presentation:ProfileListItemViewModel}">
            <Border BorderBrush="{StaticResource BrushLinePrimary}"
                    BorderThickness="{StaticResource BorderStrokePrimary}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="16,14"
                    Margin="6,0,6,12"
                    VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource BrushSurface}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="#FFFFFF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Profile Identity & Action Buttons -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Profile Name, Active Pill, Account Subtitle -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontFamily="{StaticResource FontHeading}"
                                           FontSize="16.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="180"
                                           Margin="0,0,8,0" />

                                <Border CornerRadius="{StaticResource RadiusPill}"
                                        BorderBrush="{StaticResource BrushLinePrimary}"
                                        BorderThickness="2"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrushSurfaceSoft}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushAccentPrimary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource BrushTextPrimary}" />
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="{Binding AccountSubtext}"
                                       Visibility="{Binding HasAccountSubtext, Converter={StaticResource BoolToVis}}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Right: Mini Popup Button, Run/Switch CTA Button, More Menu Button -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <!-- Mini Popup Trigger (Visible on Active Card) -->
                            <Button Style="{StaticResource SecondaryKeycapButtonStyle}"
                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                    Padding="10,5"
                                    MinHeight="32"
                                    Margin="0,0,6,0"
                                    Click="OnOpenPopupClicked"
                                    ToolTip="항상 위 미니 팝업으로 전환">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPopup}"
                                          Fill="{StaticResource BrushLinePrimary}"
                                          Width="13"
                                          Height="13"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0" />
                                    <TextBlock Text="미니 팝업" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- Primary Run / Switch Button (Hidden on Active Card to reduce clutter) -->
                            <Button IsEnabled="{Binding IsRunEnabled}"
                                    Tag="{Binding}"
                                    Padding="12,5"
                                    MinHeight="32"
                                    Margin="0,0,6,0"
                                    Click="OnPrimaryProfileActionClicked">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryKeycapButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSwitch}"
                                          Fill="{StaticResource BrushLinePrimary}"
                                          Width="13"
                                          Height="13"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding ButtonText}" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- More Options Button (Delete Profile) -->
                            <Button Style="{StaticResource IconKeycapButtonStyle}"
                                    Width="32"
                                    Height="32"
                                    MinHeight="32"
                                    Tag="{Binding}"
                                    Click="OnMoreMenuClicked"
                                    ToolTip="더보기">
                                <Path Data="{StaticResource IconMore}"
                                      Fill="{StaticResource BrushLinePrimary}"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Antigravity Usage Popover Style Card -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BrushAppBg}"
                            BorderBrush="{StaticResource BrushLinePrimary}"
                            BorderThickness="2"
                            CornerRadius="14"
                            Padding="14,10"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <!-- Section Header: Dynamic "Usage" & Status -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding UsageSectionHeader}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextMuted}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding UsageStatusMessage}"
                                           Visibility="{Binding HasUsageStatus, Converter={StaticResource BoolToVis}}"
                                           FontSize="11"
                                           FontWeight="Normal"
                                           Foreground="{StaticResource BrushTextSecondary}" />
                            </Grid>

                            <!-- Quota Groups (Gemini Models, Claude and GPT models, Gemini 4 Argon) -->
                            <ItemsControl ItemsSource="{Binding QuotaGroups}"
                                          ItemTemplate="{StaticResource QuotaGroupTemplate}" />

                            <!-- Empty state when quota hasn't been fetched yet -->
                            <TextBlock Text="새로고침을 누르거나 프로필을 활성화하면 사용량을 불러옵니다."
                                       FontSize="11.5"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUsageData}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer Window Frame -->
    <Border Background="{StaticResource BrushAppBg}"
            BorderBrush="{StaticResource BrushLinePrimary}"
            BorderThickness="{StaticResource BorderStrokePrimary}"
            CornerRadius="{StaticResource RadiusWindowFrame}">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ====================================================== -->
            <!-- 1. Custom Top Bar (Draggable)                          -->
            <!-- ====================================================== -->
            <Grid Grid.Row="0"
                  local:TitleBarDragBehavior.EnableWindowDrag="True"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Brand Title & Runtime Status Pill -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Antigravity Switcher"
                               FontFamily="{StaticResource FontHeading}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushLinePrimary}"
                            BorderThickness="2"
                            CornerRadius="{StaticResource RadiusPill}"
                            Padding="11,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Margin="0,0,7,0"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BrushTextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasActiveProfile}" Value="True">
                                                <Setter Property="Background" Value="#489E68" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding RuntimeStatusMessage}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Top Bar Action Buttons + Window Controls -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryKeycapButtonStyle}"
                            IsEnabled="{Binding CanRefreshUsage}"
                            Margin="0,0,8,0"
                            Click="OnRefreshClicked"
                            ToolTip="프로필 및 사용량 새로고침">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}"
                                  Fill="{StaticResource BrushLinePrimary}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="새로고침" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryKeycapButtonStyle}"
                            Margin="0,0,8,0"
                            Click="OnOpenSettingsClicked"
                            ToolTip="카드에 표시할 Usage 그룹/모델 선택">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSettings}"
                                  Fill="{StaticResource BrushLinePrimary}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="주요 모델" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryKeycapButtonStyle}"
                            IsEnabled="{Binding CanAddProfile}"
                            Margin="0,0,14,0"
                            Click="OnAddProfileClicked"
                            ToolTip="현재 로그인된 계정 또는 새 계정 등록">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}"
                                  Fill="{StaticResource BrushLinePrimary}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="프로필 추가" />
                        </StackPanel>
                    </Button>

                    <!-- Window Minimize / Maximize / Close -->
                    <Button Style="{StaticResource WindowControlButtonStyle}"
                            Margin="0,0,6,0"
                            Click="OnMinimizeWindowClicked"
                            ToolTip="최소화">
                        <Path Data="{StaticResource IconMinimize}"
                              Stroke="{StaticResource BrushLinePrimary}"
                              StrokeThickness="2.2"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </Button>

                    <Button Style="{StaticResource WindowControlButtonStyle}"
                            Margin="0,0,6,0"
                            Click="OnMaximizeWindowClicked"
                            ToolTip="최대화 / 복원">
                        <Path Data="{StaticResource IconMaximize}"
                              Stroke="{StaticResource BrushLinePrimary}"
                              StrokeThickness="2"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </Button>

                    <Button Style="{StaticResource WindowCloseButtonStyle}"
                            Click="OnCloseWindowClicked"
                            ToolTip="트레이로 숨기기">
                        <Path Data="{StaticResource IconClose}"
                              Stroke="{StaticResource BrushLinePrimary}"
                              StrokeThickness="2.2"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ====================================================== -->
            <!-- 2. Crash Recovery Banner (Conditional)                 -->
            <!-- ====================================================== -->
            <Border Grid.Row="1"
                    Visibility="{Binding HasPendingRecovery, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource BrushSurfaceWarn}"
                    BorderBrush="{StaticResource BrushLinePrimary}"
                    BorderThickness="{StaticResource BorderStrokePrimary}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="16,12"
                    Margin="0,0,0,14">
                <TextBlock Text="이전에 중단된 계정 전환/로그인 백업이 감지되었습니다. 프로필 전환 또는 취소 시 자동으로 복구됩니다."
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource BrushTextPrimary}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- ====================================================== -->
            <!-- 3. Scrollable Main Content (2-Column File Formation)   -->
            <!-- ====================================================== -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,4,0">
                <Grid>
                    <!-- Empty State Banner when no profiles exist yet -->
                    <Border Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVis}}"
                            Background="{StaticResource BrushSurfaceEmpty}"
                            BorderBrush="{StaticResource BrushLinePrimary}"
                            BorderThickness="{StaticResource BorderStrokePrimary}"
                            CornerRadius="{StaticResource RadiusPanel}"
                            Padding="28,32"
                            Margin="0,8,0,16">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="등록된 Antigravity 프로필이 없습니다"
                                       FontFamily="{StaticResource FontHeading}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="우측 상단 '프로필 추가' 버튼을 눌러 현재 로그인된 Antigravity 계정을 즉시 캡처하거나 새 계정을 등록해 보세요."
                                       Margin="0,8,0,18"
                                       FontSize="13.5"
                                       FontWeight="Normal"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Style="{StaticResource PrimaryKeycapButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Padding="20,10"
                                    Click="OnAddProfileClicked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}"
                                          Fill="{StaticResource BrushLinePrimary}"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          Margin="0,0,7,0" />
                                    <TextBlock Text="지금 첫 프로필 등록하기" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 2-Column File Formation (2열 종대 그리드) -->
                    <Grid Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVis}}">
                        <!-- Uniform 2-Column Grid of All Profile Cards -->
                        <ItemsControl ItemsSource="{Binding Profiles}"
                                      ItemTemplate="{StaticResource ProfileCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- 프로필이 1개뿐일 때 우측(1행 2열) 공간을 채워주는 새 계정 추가 유도 카드 -->
                        <Grid Visibility="{Binding HasSingleProfile, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="1"
                                    Background="{StaticResource BrushSurfaceEmpty}"
                                    BorderBrush="{StaticResource BrushLinePrimary}"
                                    BorderThickness="2"
                                    CornerRadius="{StaticResource RadiusCard}"
                                    Padding="20,24"
                                    Margin="6,0,6,12"
                                    VerticalAlignment="Top"
                                    MinHeight="220">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="44"
                                            Height="44"
                                            CornerRadius="22"
                                            Background="{StaticResource BrushSurfaceSoft}"
                                            BorderBrush="{StaticResource BrushLinePrimary}"
                                            BorderThickness="2"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,12">
                                        <Path Data="{StaticResource IconPlus}"
                                              Fill="{StaticResource BrushLinePrimary}"
                                              Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Text="새 Antigravity 계정 등록"
                                               FontFamily="{StaticResource FontHeading}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               HorizontalAlignment="Center" />

                                    <TextBlock Text="다른 Google 계정을 추가하여 모델별 잔여 쿼터를 나란히 모니터링하고 즉시 전환해 보세요."
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,16"
                                               MaxWidth="260" />

                                    <Button Style="{StaticResource PrimaryKeycapButtonStyle}"
                                            Padding="16,8"
                                            HorizontalAlignment="Center"
                                            Click="OnAddProfileClicked">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconPlus}"
                                                  Fill="{StaticResource BrushLinePrimary}"
                                                  Width="13"
                                                  Height="13"
                                                  Stretch="Uniform"
                                                  Margin="0,0,6,0" />
                                            <TextBlock Text="새 프로필 추가" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- ====================================================== -->
            <!-- 4. Bottom Status Bar                                   -->
            <!-- ====================================================== -->
            <Border Grid.Row="3"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushLinePrimary}"
                    BorderThickness="2"
                    CornerRadius="13"
                    Padding="14,9"
                    Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding OperationStatusMessage}"
                               FontSize="12.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProfileStatusMessage}"
                               FontSize="11.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding InstallationStatusMessage}"
                               FontSize="11.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
