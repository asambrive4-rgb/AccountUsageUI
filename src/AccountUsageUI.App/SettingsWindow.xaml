<Window x:Class="AccountUsageUI.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccountUsageUI.App"
        Title="주요 모델 설정"
        Width="520"
        Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource FontPrimary}">

    <Border Background="{StaticResource BrushAppBg}"
            BorderBrush="{StaticResource BrushLinePrimary}"
            BorderThickness="{StaticResource BorderStrokePrimary}"
            CornerRadius="{StaticResource RadiusPanel}"
            Margin="10">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" local:TitleBarDragBehavior.EnableWindowDrag="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="주요 모델 설정"
                               FontFamily="{StaticResource FontHeading}"
                               FontSize="21"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextPrimary}" />
                    <TextBlock Text="프로필 카드에 표시할 주요 모델을 선택하거나 직접 추가할 수 있습니다."
                               Margin="0,3,0,0"
                               FontSize="12.5"
                               FontWeight="Normal"
                               Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        VerticalAlignment="Top"
                        Click="OnCancelClicked"
                        ToolTip="닫기">
                    <Path Data="{StaticResource IconClose}"
                          Stroke="{StaticResource BrushLinePrimary}"
                          StrokeThickness="2.2"
                          Width="12"
                          Height="12"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- 2. Custom Model Addition Input -->
            <Border Grid.Row="1"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushLinePrimary}"
                    BorderThickness="{StaticResource BorderStrokePrimary}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="14,12"
                    Margin="0,16,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding CustomModelInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource IvoryTextBoxStyle}"
                             Margin="0,0,10,0"
                             KeyDown="OnCustomModelInputKeyDown"
                             ToolTip="추가할 모델 이름 (예: Gemini 4 Argon, Claude Sonnet 5.5)" />
                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryKeycapButtonStyle}"
                            Click="OnAddCustomModelClicked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlus}"
                                  Fill="{StaticResource BrushLinePrimary}"
                                  Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0" />
                            <TextBlock Text="모델 추가" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 3. Checkable Model List -->
            <Border Grid.Row="2"
                    Background="{StaticResource BrushSurfaceEmpty}"
                    BorderBrush="{StaticResource BrushLinePrimary}"
                    BorderThickness="{StaticResource BorderStrokePrimary}"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="14,14,10,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="0,0,4,0">
                    <ItemsControl ItemsSource="{Binding Models}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource IvoryCheckBoxStyle}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Content="{Binding ModelName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 4. Status Feedback -->
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Row="3"
                       Text="체크된 주요 모델들이 각 프로필 카드의 쿼터 목록에 표시됩니다."
                       Margin="4,10,4,0"
                       FontSize="12.5"
                       FontWeight="Normal"
                       Foreground="{StaticResource BrushTextSecondary}"
                       TextWrapping="Wrap" />

            <!-- 5. Bottom Actions -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="기본 주요 모델로 초기화"
                        Style="{StaticResource SecondaryKeycapButtonStyle}"
                        Click="OnResetToDefaultsClicked" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="취소"
                            Style="{StaticResource SecondaryKeycapButtonStyle}"
                            MinWidth="84"
                            Margin="0,0,10,0"
                            Click="OnCancelClicked" />
                    <Button Content="저장"
                            Style="{StaticResource PrimaryKeycapButtonStyle}"
                            MinWidth="96"
                            Click="OnSaveClicked" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
