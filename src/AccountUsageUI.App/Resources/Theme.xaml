    <Color x:Key="ColorSurface">#FCFAF6</Color>
    <Color x:Key="ColorSurfaceSoft">#E7E2D9</Color>
    <Color x:Key="ColorSurfaceMuted">#DBD4CB</Color>
    <Color x:Key="ColorSurfaceEmpty">#EAE5DC</Color>
    <Color x:Key="ColorSurfaceWarn">#F7E5C8</Color>
    <Color x:Key="ColorSurfaceDangerSoft">#FADED7</Color>
    <Color x:Key="ColorSurfaceSuccessSoft">#DDECD9</Color>

    <Color x:Key="ColorLinePrimary">#1E1B18</Color>
    <Color x:Key="ColorTextSecondary">#5B544D</Color>
    <Color x:Key="ColorTextMuted">#857C73</Color>

    <Color x:Key="ColorAccentPrimary">#C7D7E8</Color>
    <Color x:Key="ColorAccentPrimaryHover">#B6CADF</Color>
    <Color x:Key="ColorAccentPrimaryPressed">#A5BCD5</Color>

    <Color x:Key="ColorDangerFill">#E87A6D</Color>
    <Color x:Key="ColorDangerFillHover">#DE685A</Color>

    <SolidColorBrush x:Key="BrushAppBg" Color="{StaticResource ColorAppBg}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceSoft" Color="{StaticResource ColorSurfaceSoft}" />
    <SolidColorBrush x:Key="BrushSurfaceMuted" Color="{StaticResource ColorSurfaceMuted}" />
    <SolidColorBrush x:Key="BrushSurfaceEmpty" Color="{StaticResource ColorSurfaceEmpty}" />
    <SolidColorBrush x:Key="BrushSurfaceWarn" Color="{StaticResource ColorSurfaceWarn}" />
    <SolidColorBrush x:Key="BrushSurfaceDangerSoft" Color="{StaticResource ColorSurfaceDangerSoft}" />
    <SolidColorBrush x:Key="BrushSurfaceSuccessSoft" Color="{StaticResource ColorSurfaceSuccessSoft}" />

    <SolidColorBrush x:Key="BrushLinePrimary" Color="{StaticResource ColorLinePrimary}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorLinePrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}" />

    <SolidColorBrush x:Key="BrushAccentPrimary" Color="{StaticResource ColorAccentPrimary}" />
    <SolidColorBrush x:Key="BrushAccentPrimaryHover" Color="{StaticResource ColorAccentPrimaryHover}" />
    <SolidColorBrush x:Key="BrushAccentPrimaryPressed" Color="{StaticResource ColorAccentPrimaryPressed}" />

    <SolidColorBrush x:Key="BrushDangerFill" Color="{StaticResource ColorDangerFill}" />
    <SolidColorBrush x:Key="BrushDangerFillHover" Color="{StaticResource ColorDangerFillHover}" />

    <!-- ========================================================== -->
    <!-- 2. CornerRadius & Border Thickness Tokens                  -->
    <!-- ========================================================== -->
    <CornerRadius x:Key="RadiusWindowFrame">7</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">20</CornerRadius>
    <CornerRadius x:Key="RadiusCard">18</CornerRadius>
    <CornerRadius x:Key="RadiusControl">14</CornerRadius>
    <CornerRadius x:Key="RadiusPill">11</CornerRadius>

    <Thickness x:Key="BorderStrokePrimary">2.5</Thickness>
    <Thickness x:Key="BorderStrokeLight">2</Thickness>

    <!-- ========================================================== -->
    <!-- 3. Typography & Embedded Fonts                             -->
    <!-- ========================================================== -->
    <FontFamily x:Key="FontPrimary">pack://application:,,,/AccountUsageUI;component/Resources/Fonts/#Outfit, pack://application:,,,/AccountUsageUI;component/Resources/Fonts/#SUIT, pack://application:,,,/AccountUsageUI;component/Resources/Fonts/#NanumSquare Neo, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="FontHeading">pack://application:,,,/AccountUsageUI;component/Resources/Fonts/#Outfit, pack://application:,,,/AccountUsageUI;component/Resources/Fonts/#NanumSquare Neo, pack://application:,,,/AccountUsageUI;component/Resources/Fonts/#SUIT, Segoe UI, Malgun Gothic</FontFamily>

